# Driver plus the shared fixture modules, which register no suite of their own.
test_srcs = files(
  'main.F90',
  'test_helpers.f90',
  'test_pcm_conductor_probe.f90',
  'test_moz_fixtures.f90',
  'test_model_component_helper.f90',
  'test_model_component_pcm_fixtures.f90',
)
test_srcs += files('../../app/rism/input.f90', '../../app/rism/setup.f90')

foreach t : tests
  test_srcs += files('test_' + t + '.f90')
endforeach

tester = executable(
  'tester',
  sources: test_srcs,
  dependencies: [moist_dep, mstore_dep, testdrive_dep],
  link_language: 'fortran',
)

foreach t : tests
  runs = {t: [t]}
  if test_selected.has_key(t)
    runs = {}
    foreach sel : test_selected[t]
      runs += {t + '_' + sel: [t, sel]}
    endforeach
  endif
  foreach name, test_args : runs
    test(
      name,
      tester,
      args: test_args,
      env: test_env,
      is_parallel : true,
      timeout: test_timeouts.get(t, 420),
    )
  endforeach
endforeach
