  # reference_values solves an 8192-point TIP3P VV and three solutes; minutes in debug
  'moz_1d_uv': 900,
  'moz_3d_response': 900,
  # four complete-model gradients with finite differences; over 420 s in debug CI
  'moz_1d_gradient': 900,
}

