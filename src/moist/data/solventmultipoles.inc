                                            -19.61435_wp, -19.61435_wp, -19.61435_wp, 0.0_wp, -0.0_wp, &
                                            0.0_wp], [6, 1])
            multipoles%octupole = reshape([ &
                                          1e-06_wp, -1e-06_wp, 0.0_wp, 1e-06_wp, -0.0_wp, &
                                          -0.0_wp, 0.0_wp, 1e-06_wp, 0.0_wp, -0.0_wp], [10, 1])
         case ("solvent")
            multipoles%monopole = [ &
                                  0.0_wp]
            multipoles%dipole = reshape([ &
                                        -0.0_wp, 1e-06_wp, 1e-06_wp], [3, 1])
            multipoles%quadrupole = reshape([ &
                                            -19.614498_wp, -19.614498_wp, -19.614499_wp, -1e-06_wp, 0.0_wp, &
                                            0.0_wp], [6, 1])
            multipoles%octupole = reshape([ &
                                          -5e-06_wp, 1.4e-05_wp, 6e-06_wp, 1e-06_wp, 3e-06_wp, &
                                          -0.0_wp, -0.0_wp, -1e-06_wp, 4e-06_wp, 6e-06_wp], [10, 1])
         case ("conductor")
            multipoles%monopole = [ &
                                  0.0_wp]
            multipoles%dipole = reshape([ &
                                        -4.4e-05_wp, 0.000413_wp, 0.000229_wp], [3, 1])
            multipoles%quadrupole = reshape([ &
                                            -19.610472_wp, -19.614441_wp, -19.619024_wp, -0.00313_wp, 0.006334_wp, &
                                            0.005403_wp], [6, 1])
            multipoles%octupole = reshape([ &
                                          0.001123_wp, -0.003089_wp, 0.001088_wp, 0.002103_wp, -0.001374_wp, &
                                          -0.00036_wp, 0.000401_wp, -0.000466_wp, -0.000832_wp, -0.001061_wp], [10, 1])
         case default
            call fatal_error(error, message="Unknown solvent environment: "//trim(environment))
         end select
      case default
         write (msg, "(a,i0)") "No multipole data available for solvent ID ", solvent_id
         call fatal_error(error, message=trim(msg))
      end select
   case default
      call fatal_error(error, message="Unknown solvent multipole model: "//trim(model))
   end select
end subroutine get_solvent_multipoles
